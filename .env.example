# Copy to .env and fill in. Never commit .env.
#
# Generate the secrets with something like:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_DB=balancevault
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_PORT=5432

# Two database roles, two passwords, on purpose:
#   migrator -> prisma migrate deploy and the one-time admin bootstrap
#   app      -> the API. No DDL, no UPDATE on ledger_entries/audit_log.
MIGRATOR_PASSWORD=change-me-migrator
APP_PASSWORD=change-me-app

JWT_SECRET=change-me-64-chars-minimum

REDIS_PORT=6379
API_PORT=8000
