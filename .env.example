# Copy to .env and edit. Never commit .env.

# --- required in production -------------------------------------------------
# 32+ characters. Generate with: python -c 'import secrets;print(secrets.token_urlsafe(48))'
LEDGERLINE_JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# dev | prod   (prod refuses to boot with a weak secret and sends HSTS)
LEDGERLINE_ENV=prod

# --- storage ----------------------------------------------------------------
LEDGERLINE_DATABASE_PATH=/data/ledgerline.db

# Serve the built SPA from the API process (single origin, no CORS).
# In Docker this points at /app/frontend/dist; leave empty for API-only.
LEDGERLINE_STATIC_DIR=/app/frontend/dist

# --- demo data --------------------------------------------------------------
# 1 = create the demo users/accounts on boot. Use 0 in production.
LEDGERLINE_DEMO_SEED=1

# --- web --------------------------------------------------------------------
# Comma-separated allowlist. Leave empty to serve same-origin only (recommended
# when the SPA is served by this process).
LEDGERLINE_CORS_ORIGINS=

# Only set behind a reverse proxy: also enables X-Forwarded-For for client IPs.
# LEDGERLINE_TRUSTED_HOSTS=ledger.example.com

# --- limits -----------------------------------------------------------------
# LEDGERLINE_MAX_AMOUNT_MINOR=10000000          # 100,000.00 per movement
# LEDGERLINE_MONEY_WRITES_PER_MINUTE=30
# LEDGERLINE_LOGIN_MAX_FAILURES=5
# LEDGERLINE_LOGIN_MAX_FAILURES_PER_IP=50
# LEDGERLINE_LOGIN_LOCKOUT_SECONDS=900
# LEDGERLINE_ACCESS_TTL_SECONDS=900
# LEDGERLINE_REFRESH_TTL_SECONDS=2592000
# LEDGERLINE_BCRYPT_ROUNDS=12
# LEDGERLINE_SQLITE_BUSY_TIMEOUT_MS=10000
